{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "iac_engine", "project", "environment", "tenant_id", "region", "vpc_id", "subnet_ids", "route_table_ids", "sql_cidr", "sql_port", "source_schema", "source_table", "retention_days", "max_rows", "schedule_enabled", "schedule_expression"],
  "properties": {
    "contract_version": {"const": "1"},
    "iac_engine": {"enum": ["terraform", "cdk"]},
    "project": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,9}$"},
    "environment": {"enum": ["dev", "test", "prod"]},
    "tenant_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,15}$"},
    "region": {"type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]+$"},
    "vpc_id": {"type": "string", "pattern": "^vpc-[a-f0-9]{8,17}$"},
    "subnet_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^subnet-[a-f0-9]{8,17}$"}},
    "route_table_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^rtb-[a-f0-9]{8,17}$"}},
    "sql_cidr": {"type": "string"},
    "sql_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "source_schema": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
    "source_table": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
    "retention_days": {"type": "integer", "minimum": 1},
    "max_rows": {"type": "integer", "minimum": 1, "maximum": 100000},
    "schedule_enabled": {"type": "boolean"},
    "schedule_expression": {"type": "string", "minLength": 1}
  }
}
